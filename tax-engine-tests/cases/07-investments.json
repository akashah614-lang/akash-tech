    {
      "id": "niit-magi-over-nii-limit",
      "name": "NIIT — NII smaller than MAGI excess, so NII is the limit",
      "kind": "analytical",
      "citation": "IRC §1411(a)(1)",
      "rationale": "Single, wages 210000, interest 5000. L11=215000. MAGI−200K = 15000. NII = 5000. 3.8% × min(5000, 15000) = 3.8% × 5000 = 190.",
      "input": {
        "filing_status": "Single", "taxpayer_age": "40",
